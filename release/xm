}

# ── 清理旧文件 ──
do_clean() {
    echo "=== XiaoMiaoOS 清理工具 ==="
    echo ""
    local total_freed=0

    # 1. 清理旧固件（只保留最新OTA和底包）
    echo "[1/4] 清理旧固件..."
    if [ -d "$FW_DIR" ]; then
        local latest_ota=$(ls -t "$FW_DIR"/xiaomiao_ota_V*.bin 2>/dev/null | head -1)
        local latest_base=$(ls -t "$FW_DIR"/xiaomiao_base_V*.bin 2>/dev/null | head -1)
        for f in "$FW_DIR"/xiaomiao_ota_V*.bin "$FW_DIR"/xiaomiao_base_V*.bin "$FW_DIR"/xiaomiao_V*.bin; do
            if [ -f "$f" ]; then
                # 保留最新的OTA包和底包
                if [ "$f" = "$latest_ota" ] || [ "$f" = "$latest_base" ]; then
                    echo "  keep $(basename "$f")"
                else
                    local sz=$(wc -c < "$f")
                    rm -f "$f"
                    echo "  del $(basename "$f") ($sz bytes)"
                    total_freed=$((total_freed + sz))
                fi
            fi
        done
    fi
    echo ""

    # 2. 清理临时文件
    echo "[2/4] 清理临时文件..."
    local tmp_count=0
    for f in "$DIR"/*.tmp "$DIR"/*.tmp.*; do
        if [ -f "$f" ]; then
            local sz=$(wc -c < "$f")
            rm -f "$f"
            tmp_count=$((tmp_count + 1))
            total_freed=$((total_freed + sz))
        fi
    done
    echo "  删除 $tmp_count 个临时文件"
    echo ""

    # 3. 裁剪大日志
    echo "[3/4] 清理日志..."
    local log_count=0
    for f in "$DIR"/*.log; do
        if [ -f "$f" ]; then
            local sz=$(wc -c < "$f")
            if [ "$sz" -gt 102400 ]; then
                tail -50 "$f" > "$f.tail" 2>/dev/null
                mv "$f.tail" "$f" 2>/dev/null
                local new_sz=$(wc -c < "$f")
                local saved=$((sz - new_sz))
                total_freed=$((total_freed + saved))
                log_count=$((log_count + 1))
                echo "  trim $(basename "$f") (saved $saved bytes)"
            fi
        fi
    done
    echo "  裁剪 $log_count 个日志"
    echo ""

    # 4. 空间统计
    echo "[4/4] 空间统计..."
    if [ -d "$DIR" ]; then
        echo "  目录大小: $(du -sh "$DIR" 2>/dev/null | cut -f1)"
        echo "  文件数量: $(ls "$DIR" 2>/dev/null | wc -l)"
    fi
    echo ""
    local freed_kb=$((total_freed / 1024))
    echo "╔══════════════════════════════════════╗"
    printf "║  释放空间: %-26s║\n" "$freed_kb KB"
    echo "╚══════════════════════════════════════╝"
}

# ── 设置沙盒地址 ──
do_seturl() {
    if [ -z "$1" ]; then
        echo "用法: xm seturl https://xxx.lhr.life"
        echo "     xm seturl http://192.168.1.100:8080"
        echo ""
        if [ -f "$CACHE_FILE" ]; then
            echo "当前地址: $(cat "$CACHE_FILE")"
        else
            echo "当前地址: (未设置)"
        fi
        return
    fi
    # 去除尾部斜杠
    local url=$(echo "$1" | sed 's/\/$//')
    echo "$url" > "$CACHE_FILE"
    echo "✓ 沙盒地址已设置: $url"
    echo "  验证连接..."
    if check_url_alive "$url"; then
        echo "  ✓ 连接成功!"
    else
        echo "  ⚠ 无法连接，请检查地址是否正确"
    fi
}

# ── 设备OTA回滚状态 ──
do_rollback() {
    echo "=== OTA 回滚保护说明 ==="
    echo ""
    echo "设备端已启用OTA自动回滚保护:"
    echo ""
    echo "  1. OTA更新后，新固件进入 PENDING_VERIFY 状态"
    echo "  2. 如果新固件正常运行10秒，自动标记为 VALID"
    echo "  3. 如果新固件在10秒内崩溃或重启:"
    echo "     → 引导加载器自动回滚到上一个正常固件"
    echo ""
    echo "  手动强制回滚 (需要USB连接设备):"
    echo "    esptool.py --port /dev/ttyUSB0 erase_region 0x3D000 0x1000"
    echo "    (擦除otadata分区，强制回到ota_0)"
    echo ""
    echo "  查看当前分区状态 (串口日志):"
    echo "    xm log | grep OTA"
    echo ""
    echo "  当前固件版本: v$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['version'])" 2>/dev/null || echo 'unknown')"
}

# ── 自动检测更新: 云端版本→下载→检测设备→清理旧固件 ──
do_check() {
    echo "╔══════════════════════════════════════╗"
    echo "║  XiaoMiaoOS 自动更新检测              ║"
    echo "╚══════════════════════════════════════╝"
    echo ""

    # ── Step 1: 获取云端最新版本 ──
    echo "[1/4] 检测云端最新版本..."
    local url=$(get_url_cached 2>/dev/null)
    if [ -z "$url" ]; then
        echo "  ✗ 沙盒离线，无法检测云端版本"
        echo ""
        echo "  用 xm seturl <地址> 手动设置沙盒"
        return 1
    fi
    save_url "$url"

    # 拉取 version.json
    curl -s --max-time 15 "$url/version.json" -o "$DIR/version.json.tmp" 2>/dev/null
    if [ ! -s "$DIR/version.json.tmp" ]; then
        echo "  ✗ version.json 下载失败"
        rm -f "$DIR/version.json.tmp"
        if [ -f "$DIR/version.json" ]; then
            echo "  使用本地缓存的version.json"
        else
            return 1
        fi
    else
        if ! python3 -c "import json;json.load(open('$DIR/version.json.tmp'))" 2>/dev/null; then
            echo "  ✗ version.json 无效"
            rm -f "$DIR/version.json.tmp"
            return 1
        fi
        mv "$DIR/version.json.tmp" "$DIR/version.json"
    fi

    local cloud_ver=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['version'])" 2>/dev/null)
    local cloud_name=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['files']['ota']['name'])" 2>/dev/null)
    local cloud_size=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['files']['ota']['size'])" 2>/dev/null)
    local cloud_sha=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['files']['ota']['sha256'])" 2>/dev/null)
    local cloud_url=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['files']['ota']['url'])" 2>/dev/null)
    echo "  ✓ 云端最新版本: v$cloud_ver"
    echo "  文件: $cloud_name ($cloud_size bytes)"
    echo ""

    # ── Step 2: 检查本地是否已有该版本固件 ──
    echo "[2/4] 检查本地固件..."
    local fw_path="$FW_DIR/$cloud_name"
    local need_download=true
    if [ -f "$fw_path" ]; then
        local local_size=$(wc -c < "$fw_path")
        if [ "$local_size" = "$cloud_size" ]; then
            echo "  ✓ 本地已有相同版本，跳过下载"
            need_download=false
        else
            echo "  本地文件大小不匹配，重新下载"
            rm -f "$fw_path"
        fi
    else
        echo "  本地无此版本固件"
    fi

    # ── Step 3: 如果需要，从云端下载固件到本地 ──
    if [ "$need_download" = "true" ]; then
        echo ""
        echo "[3/4] 从云端下载固件..."
        mkdir -p "$FW_DIR"
        local full_url="$url/$cloud_url"
        echo "  下载: $full_url"
        curl -s --max-time 120 "$full_url" -o "$fw_path.tmp" 2>/dev/null
        if [ ! -s "$fw_path.tmp" ]; then
            echo "  ✗ 下载失败"
            rm -f "$fw_path.tmp"
            return 1
        fi
        local dl_size=$(wc -c < "$fw_path.tmp")
        if [ "$dl_size" != "$cloud_size" ]; then
            echo "  ✗ 大小不匹配: 期望 $cloud_size, 实际 $dl_size"
            rm -f "$fw_path.tmp"
            return 1
        fi
        local dl_sha=$(sha256sum "$fw_path.tmp" | cut -d' ' -f1)
        if [ "$dl_sha" != "$cloud_sha" ]; then
            echo "  ✗ SHA256 校验失败"
            rm -f "$fw_path.tmp"
            return 1
        fi
        echo "  ✓ SHA256 校验通过"
        mv "$fw_path.tmp" "$fw_path"
        echo "  ✓ 下载完成 ($dl_size bytes)"
    else
        echo ""
        echo "[3/4] 跳过下载（本地已有）"
    fi
    echo ""

    # ── Step 4: 检测设备版本，如果已是最新则删除旧固件 ──
    echo "[4/4] 检测设备版本..."
    # 尝试连接设备 WebUI 获取版本号
    # 先尝试 AP 模式 (192.168.4.1)，再尝试缓存URL解析出的IP
    local device_ip="192.168.4.1"
    local device_ver=""
    local dev_resp=$(curl -s --max-time 5 "http://$device_ip/api/sysinfo" 2>/dev/null)
    if [ -n "$dev_resp" ]; then
        device_ver=$(echo "$dev_resp" | python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('version',''))" 2>/dev/null)
    fi
    # 如果AP模式连不上，尝试 STA 模式（从URL提取IP）
    if [ -z "$device_ver" ]; then
        # 从沙盒URL提取IP尝试，设备可能在同网段
        local host=$(echo "$url" | grep -oP 'http://\K[0-9.]+' | head -1)
        if [ -n "$host" ] && [ "$host" != "192.168.4.1" ]; then
            dev_resp=$(curl -s --max-time 3 "http://$host/api/sysinfo" 2>/dev/null)
            if [ -n "$dev_resp" ]; then
                device_ver=$(echo "$dev_resp" | python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('version',''))" 2>/dev/null)
            fi
        fi
    fi

    if [ -n "$device_ver" ]; then
        echo "  ✓ 设备版本: v$device_ver"
        # 比较版本号
        local dev_newer=false
        local c1=0 c2=0 c3=0 d1=0 d2=0 d3=0
        IFS='.' read c1 c2 c3 <<< "$cloud_ver"
        IFS='.' read d1 d2 d3 <<< "$device_ver"
        if [ "$d1" -gt "$c1" ] 2>/dev/null || \
           ([ "$d1" -eq "$c1" ] && [ "$d2" -gt "$c2" ]) 2>/dev/null || \
           ([ "$d1" -eq "$c1" ] && [ "$d2" -eq "$c2" ] && [ "$d3" -ge "$c3" ]) 2>/dev/null; then
            dev_newer=true
        fi

        if [ "$dev_newer" = "true" ]; then
            echo "  ✓ 设备已是最新版本！"
            echo ""
            echo "  清理旧版本固件..."
            local deleted=0
            local freed=0
            for f in "$FW_DIR"/xiaomiao_ota_V*.bin "$FW_DIR"/xiaomiao_base_V*.bin "$FW_DIR"/xiaomiao_V*.bin; do
                if [ -f "$f" ]; then
                    local basename_f=$(basename "$f")
                    # 保留当前版本文件
                    if [ "$basename_f" != "$cloud_name" ]; then
                        local sz=$(wc -c < "$f")
                        rm -f "$f"
                        echo "    del $basename_f ($sz bytes)"
                        deleted=$((deleted + 1))
                        freed=$((freed + sz))
                    fi
                fi
            done
            if [ "$deleted" -gt 0 ]; then
                echo "  ✓ 删除 $deleted 个旧固件，释放 $((freed / 1024)) KB"
            else
                echo "  (无旧固件需要清理)"
            fi
            echo ""
            echo "╔══════════════════════════════════════╗"
            echo "║  ✓ 设备已是最新版本 v$device_ver              ║"
            echo "║  旧固件已清理，无需操作              ║"
            echo "╚══════════════════════════════════════╝"
        else
            echo "  ⚠ 设备版本 v$device_ver 低于云端 v$cloud_ver"
            echo "  需要更新设备"
            echo ""
            echo "  固件已下载到本地:"
            echo "  $fw_path"
            echo ""
            echo "  更新方式:"
            echo "    A. USB刷入: xm flash"
            echo "    B. 设备OTA: 菜单 SYSTEM → Check Update"
            echo "    C. 设备已连WiFi时直接OTA:"
            echo "       curl http://$device_ip/api/do_update?url=$url/$cloud_url"
        fi
    else
        echo "  ⚠ 无法连接设备 (尝试了 192.168.4.1)"
        echo "  设备可能未开机或未连接"
        echo ""
        echo "  固件已下载到本地:"
        echo "  $fw_path"
        echo ""
        echo "  更新方式:"
        echo "    A. USB刷入: xm flash"
        echo "    B. 设备OTA: 菜单 SYSTEM → Check Update"
    fi
}

# ── 主逻辑 ──
# xm 已通过 install 部署为系统命令，不再自动下载自身

case "${1:-run}" in
    pull)     do_pull ;;
    start)    do_start ;;
    stop)     do_stop ;;
    status)   do_status ;;
    log)      do_log ;;
    clean)    do_clean ;;
    fw)       do_fw ;;
    base)     do_base ;;
    check)    do_check ;;
    flash)    do_flash ;;
    ports)    do_ports ;;
    install)  do_install ;;
    seturl)   do_seturl "$2" ;;
    rollback) do_rollback ;;
    update)   do_pull && do_stop && do_start ;;
    run|"")   do_check && echo "" && do_pull && do_start ;;
    *) echo "XiaoMiaoOS 快捷命令 v3.3"
       echo ""
       echo "用法: xm [命令]"
       echo ""
       echo "命令:"
       echo "  xm          自动检测更新+拉取+启动 (默认)"
       echo "  xm check    只检测更新(云端→下载→检测设备→清理)"
       echo "  xm pull     只拉取脚本文件"
       echo "  xm start    只启动"
       echo "  xm stop     停止所有服务"
       echo "  xm status   查看状态"
       echo "  xm log      查看日志"
       echo "  xm update   强制拉取+重启"
       echo "  xm fw       拉取OTA更新包(固件)"
       echo "  xm base     拉取底包(全量刷机包)"
       echo "  xm flash    拉取固件+USB刷入设备"
       echo "  xm ports    列出可用串口"
       echo "  xm install  安装xm为系统命令"
       echo "  xm clean    清理旧文件释放空间"
       echo "  xm seturl   设置沙盒地址"
       echo "  xm rollback 查看OTA回滚状态" ;;
esac
