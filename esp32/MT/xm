#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════
#  xm — XiaoMiaoOS 快捷命令 v3.0
#  改进：本地缓存优先 + 自动更新自身
#  用法:
#    xm          拉取+启动 (默认)
#    xm pull     只拉取文件不启动
#    xm start    只启动不拉取
#    xm stop     停止所有服务
#    xm status   查看运行状态
#    xm log      查看日志
#    xm update   强制拉取+重启
#    xm fw       从沙盒拉取最新固件 (不刷入)
#    xm flash    拉取固件 + USB刷入设备
#    xm ports    列出可用串口
#    xm clean    清理旧文件释放空间
# ═══════════════════════════════════════════════

DIR="$HOME/xiaomiao-release"
FW_DIR="$DIR/firmware"
CACHE_FILE="$DIR/last_url.txt"
DISCOVERY="https://webhook.site/c61b1703-3603-42c5-abae-c371a0ddd8de"

# ── 自动更新自身（静默执行）──
self_update() {
    local url=$(get_url_cached)
    if [ -z "$url" ]; then
        return
    fi
    # 下载最新版本
    local new_xm=$(curl -s --max-time 10 "$url/xm" 2>/dev/null)
    if [ -n "$new_xm" ]; then
        # 检查是否是有效脚本（不是HTML错误页）
        local first_line=$(echo "$new_xm" | head -1)
        if echo "$first_line" | grep -q "^#!" 2>/dev/null; then
            # 检查版本号是否更新
            local cur_ver=$(grep 'xm — XiaoMiaoOS' "$DIR/xm" 2>/dev/null | grep -oP 'v[0-9.]+' | head -1)
            local new_ver=$(echo "$new_xm" | grep 'xm — XiaoMiaoOS' | grep -oP 'v[0-9.]+' | head -1)
            if [ "$cur_ver" != "$new_ver" ] 2>/dev/null; then
                echo "$new_xm" > "$DIR/xm"
                chmod +x "$DIR/xm"
                echo "  xm 已自动更新 ($cur_ver → $new_ver)"
                # 重新执行自身
                exec bash "$DIR/xm" "$@"
            fi
        fi
    fi
}

# ── 获取沙盒地址（本地缓存优先）──
get_url_cached() {
    # 1. 先读本地缓存
    if [ -f "$CACHE_FILE" ]; then
        local cached=$(cat "$CACHE_FILE" 2>/dev/null)
        if [ -n "$cached" ]; then
            # 验证缓存URL是否可用
            if curl -s --max-time 5 "$cached/health" >/dev/null 2>&1; then
                echo "$cached"
                return
            fi
        fi
    fi

    # 2. 缓存不可用，尝试 webhook
    local json=$(curl -s --max-time 10 "$DISCOVERY" 2>/dev/null)
    if [ -n "$json" ]; then
        local url=$(echo "$json" | python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('webdav_url','').rstrip('/'))" 2>/dev/null)
        if [ -n "$url" ]; then
            echo "$url" > "$CACHE_FILE"
            echo "$url"
            return
        fi
    fi

    # 3. webhook 也失败，返回空
    echo ""
}

# ── 保存URL到缓存 ──
save_url() {
    echo "$1" > "$CACHE_FILE"
}

# ── 拉取单个文件 ──
pull_file() {
    local url="$1" name="$2"
    curl -s --max-time 30 "$url/$name" -o "$DIR/$name.tmp" 2>/dev/null
    if [ -s "$DIR/$name.tmp" ]; then
        local first3=$(head -3 "$DIR/$name.tmp" 2>/dev/null)
        if echo "$first3" | grep -qi "<!DOCTYPE\|<html\|<HTML\|<h1>\|tunnel here\|502 Bad\|503 Service\|404 Not Found\|Service Unavailable" 2>/dev/null; then
            echo "  fail $name (HTML error page)"
            rm -f "$DIR/$name.tmp"
        elif echo "$name" | grep -q "\.sh$\|\.py$" 2>/dev/null; then
            local first_line=$(head -1 "$DIR/$name.tmp" 2>/dev/null)
            if echo "$first_line" | grep -q "^#\|^import\|^from\|^#!/" 2>/dev/null; then
                mv "$DIR/$name.tmp" "$DIR/$name"
                chmod +x "$DIR/$name" 2>/dev/null
                echo "  ok $name"
            else
                echo "  fail $name (invalid content)"
                rm -f "$DIR/$name.tmp"
            fi
        else
            mv "$DIR/$name.tmp" "$DIR/$name"
            echo "  ok $name"
        fi
    else
        rm -f "$DIR/$name.tmp"
        echo "  fail $name (empty)"
    fi
}

# ── 拉取全部 ──
do_pull() {
    mkdir -p "$DIR" "$FW_DIR"
    local url=$(get_url_cached)
    if [ -z "$url" ]; then
        echo "✗ 沙盒离线"
        echo ""
        echo "解决方法:"
        echo "  1. 确认手机能上网"
        echo "  2. 手动设置沙盒地址:"
        echo "     echo 'https://xxx.lhr.life' > ~/xiaomiao-release/last_url.txt"
        echo "  3. 然后重新运行: xm"
        return 1
    fi

    save_url "$url"
    echo "沙盒: $url"
    echo "拉取文件..."

    for f in start_all.sh webdav_server.py relay_server.sh xiaomiao_daemon.sh watchdog.sh tunnel_watchdog.py relay_client.sh zerotermux_setup.sh version.json xm; do
        pull_file "$url" "$f"
    done

    # 自动更新自身
    if [ -f "$DIR/xm" ]; then
        chmod +x "$DIR/xm"
    fi

    echo "done"
}

# ── 从沙盒拉取最新固件 ──
do_fw() {
    mkdir -p "$FW_DIR"
    local url=$(get_url_cached)
    if [ -z "$url" ]; then
        echo "✗ 沙盒离线"
        # 检查本地是否已有固件
        local latest_local=$(ls -t "$FW_DIR"/xiaomiao_V*.bin 2>/dev/null | head -1)
        if [ -n "$latest_local" ]; then
            echo "  本地最新固件: $(basename "$latest_local")"
            echo "  路径: $latest_local"
            echo "$latest_local"
            return 0
        fi
        return 1
    fi

    save_url "$url"
    echo "=== 从沙盒拉取最新固件 ==="
    echo "沙盒: $url"
    echo ""

    # 1. 拉取 version.json
    echo "[1/3] 获取版本信息..."
    curl -s --max-time 15 "$url/version.json" -o "$DIR/version.json.tmp" 2>/dev/null
    if [ ! -s "$DIR/version.json.tmp" ]; then
        echo "  ✗ version.json 下载失败"
        rm -f "$DIR/version.json.tmp"
        return 1
    fi
    if ! python3 -c "import json;json.load(open('$DIR/version.json.tmp'))" 2>/dev/null; then
        echo "  ✗ version.json 不是有效 JSON"
        rm -f "$DIR/version.json.tmp"
        return 1
    fi
    mv "$DIR/version.json.tmp" "$DIR/version.json"

    local fw_version=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['version'])" 2>/dev/null)
    local fw_url=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['url'])" 2>/dev/null)
    local fw_size=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['size'])" 2>/dev/null)
    local fw_sha256=$(python3 -c "import json;d=json.load(open('$DIR/version.json'));print(d['latest']['sha256'])" 2>/dev/null)
    local fw_name="xiaomiao_V${fw_version}.bin"

    echo "  ✓ 最新版本: v$fw_version"
    echo "  固件文件: $fw_url"
    echo "  大小: $fw_size bytes"
    echo ""

    # 2. 检查本地是否已有该版本
    local fw_path="$FW_DIR/$fw_name"
    if [ -f "$fw_path" ]; then
        local local_size=$(wc -c < "$fw_path")
        if [ "$local_size" = "$fw_size" ]; then
            echo "[2/3] 本地已有相同版本，跳过下载"
            echo "  $fw_name ($local_size bytes)"
            echo ""
            echo "[3/3] 固件就绪"
            echo "  路径: $fw_path"
            echo "$fw_path"
            return 0
        fi
    fi

    # 3. 下载固件
    echo "[2/3] 下载固件 $fw_name ..."
    local full_url="$url/$fw_url"
    curl -s --max-time 120 "$full_url" -o "$fw_path.tmp" 2>/dev/null

    if [ ! -s "$fw_path.tmp" ]; then
        echo "  ✗ 下载失败"
        rm -f "$fw_path.tmp"
        return 1
    fi

    local dl_size=$(wc -c < "$fw_path.tmp")
    if [ "$dl_size" != "$fw_size" ]; then
        echo "  ✗ 大小不匹配: 期望 $fw_size, 实际 $dl_size"
        rm -f "$fw_path.tmp"
        return 1
    fi

    if [ -n "$fw_sha256" ]; then
        local dl_sha256=$(sha256sum "$fw_path.tmp" | cut -d' ' -f1)
        if [ "$dl_sha256" != "$fw_sha256" ]; then
            echo "  ✗ SHA256 校验失败"
            rm -f "$fw_path.tmp"
            return 1
        fi
        echo "  ✓ SHA256 校验通过"
    fi

    mv "$fw_path.tmp" "$fw_path"
    echo "  ✓ 下载完成 ($dl_size bytes)"
    echo ""

    # 显示更新日志
    echo "=== 更新日志 v$fw_version ==="
    python3 -c "
import json
d=json.load(open('$DIR/version.json'))
for line in d['latest']['changelog']:
    print('  - ' + line)
" 2>/dev/null
    echo ""

    echo "[3/3] 固件就绪"
    echo "  路径: $fw_path"
    echo "$fw_path"
}

# ── 查找串口设备 ──
find_port() {
    local port=""
    for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyACM0 /dev/ttyACM1; do
        if [ -e "$p" ]; then
            port="$p"
            break
        fi
    done
    echo "$port"
}

# ── 列出串口 ──
do_ports() {
    echo "=== 可用串口设备 ==="
    local found=0
    for p in /dev/ttyUSB* /dev/ttyACM*; do
        if [ -e "$p" ]; then
            echo "  $p"
            found=1
        fi
    done
    if [ "$found" = "0" ]; then
        echo "  (未找到串口设备)"
        echo ""
        echo "提示:"
        echo "  - 确保手机支持 USB OTG"
        echo "  - 确保 USB 线支持数据传输"
        echo "  - 喵比特连接后需要开机"
    fi
}

# ── 拉取固件 + USB 刷入 ──
do_flash() {
    echo "╔══════════════════════════════════════╗"
    echo "║  XiaoMiaoOS 固件刷入工具             ║"
    echo "╚══════════════════════════════════════╝"
    echo ""

    # 1. 拉取固件
    local fw_path=$(do_fw)
    if [ -z "$fw_path" ] || [ ! -f "$fw_path" ]; then
        echo ""
        echo "✗ 固件获取失败，无法刷入"
        return 1
    fi
    echo ""

    # 2. 检查 esptool
    echo "=== 检查 esptool ==="
    if ! command -v esptool.py &>/dev/null; then
        echo "  安装 esptool..."
        pip install esptool --break-system-packages 2>/dev/null || pip install esptool 2>/dev/null
    fi
    if ! command -v esptool.py &>/dev/null; then
        echo "  ✗ esptool 安装失败"
        echo "  手动安装: pip install esptool"
        return 1
    fi
    echo "  ✓ esptool 已就绪"
    echo ""

    # 3. 查找串口
    echo "=== 查找设备 ==="
    local port=$(find_port)
    if [ -z "$port" ]; then
        echo "  ✗ 未找到串口设备"
        echo ""
        do_ports
        echo ""
        echo "手动指定端口:"
        echo "  esptool.py --port /dev/ttyUSB0 --baud 921600 write_flash 0x10000 \"$fw_path\""
        return 1
    fi
    echo "  ✓ 设备端口: $port"
    echo ""

    # 4. 刷入
    echo "=== 开始刷入 ==="
    echo "  固件: $(basename "$fw_path")"
    echo "  端口: $port"
    echo "  地址: 0x10000"
    echo "  波特: 921600"
    echo ""

    esptool.py --port "$port" --baud 921600 write_flash 0x10000 "$fw_path"
    local ret=$?

    echo ""
    if [ $ret -eq 0 ]; then
        echo "╔══════════════════════════════════════╗"
        echo "║  ✓ 刷入成功！                        ║"
        echo "╚══════════════════════════════════════╝"
        echo ""
        echo "下一步:"
        echo "  1. 设备会自动重启"
        echo "  2. 连接 WiFi: XiaoMiao-CFG"
        echo "  3. 打开浏览器: http://192.168.4.1"
        echo "  4. 在菜单 SYSTEM → Check Update 检查更新"
    else
        echo "╔══════════════════════════════════════╗"
        echo "║  ✗ 刷入失败                          ║"
        echo "╚══════════════════════════════════════╝"
        echo ""
        echo "可能原因:"
        echo "  - 设备未进入下载模式 (按住 BOOT 键再上电)"
        echo "  - USB 线不支持数据传输"
        echo "  - 端口被其他程序占用"
        echo ""
        echo "重试: xm flash"
    fi
    return $ret
}

# ── 启动 ──
do_start() {
    bash "$DIR/start_all.sh"
}

# ── 停止 ──
do_stop() {
    pkill -f "watchdog.sh" 2>/dev/null
    pkill -f "webdav_server.py" 2>/dev/null
    bash "$DIR/relay_server.sh" stop 2>/dev/null
    echo "stopped"
}

# ── 状态 ──
do_status() {
    echo "=== XiaoMiaoOS Status ==="
    pgrep -f "webdav_server.py" >/dev/null 2>&1 && echo "  WebDAV:    RUNNING" || echo "  WebDAV:    STOPPED"
    pgrep -f "relay_server.sh" >/dev/null 2>&1 && echo "  Relay:     RUNNING" || echo "  Relay:     STOPPED"
    pgrep -f "watchdog.sh" >/dev/null 2>&1 && echo "  Watchdog:  RUNNING" || echo "  Watchdog:  STOPPED"

    local url=$(get_url_cached)
    [ -n "$url" ] && echo "  Sandbox:   ONLINE ($url)" || echo "  Sandbox:   OFFLINE"

    echo ""
    echo "=== 本地固件 ==="
    if [ -d "$FW_DIR" ] && ls "$FW_DIR"/xiaomiao_V*.bin >/dev/null 2>&1; then
        for f in "$FW_DIR"/xiaomiao_V*.bin; do
            local sz=$(wc -c < "$f")
            printf "  %-30s %s bytes\n" "$(basename "$f")" "$sz"
        done
    else
        echo "  (无)  用 xm fw 拉取"
    fi
}

# ── 日志 ──
do_log() {
    tail -50 "$DIR/server.log" 2>/dev/null || echo "no log"
}

# ── 清理旧文件 ──
do_clean() {
    echo "=== XiaoMiaoOS 清理工具 ==="
    echo ""
    local total_freed=0

    # 1. 清理旧固件（只保留最新）
    echo "[1/4] 清理旧固件..."
    if [ -d "$FW_DIR" ]; then
        local latest_fw=$(ls -t "$FW_DIR"/xiaomiao_V*.bin 2>/dev/null | head -1)
        if [ -n "$latest_fw" ]; then
            for f in "$FW_DIR"/xiaomiao_V*.bin; do
                if [ "$f" != "$latest_fw" ] && [ -f "$f" ]; then
                    local sz=$(wc -c < "$f")
                    rm -f "$f"
                    echo "  del $(basename "$f") ($sz bytes)"
                    total_freed=$((total_freed + sz))
                fi
            done
            echo "  keep $(basename "$latest_fw")"
        fi
    fi
    echo ""

    # 2. 清理临时文件
    echo "[2/4] 清理临时文件..."
    local tmp_count=0
    for f in "$DIR"/*.tmp "$DIR"/*.tmp.*; do
        if [ -f "$f" ]; then
            local sz=$(wc -c < "$f")
            rm -f "$f"
            tmp_count=$((tmp_count + 1))
            total_freed=$((total_freed + sz))
        fi
    done
    echo "  删除 $tmp_count 个临时文件"
    echo ""

    # 3. 裁剪大日志
    echo "[3/4] 清理日志..."
    local log_count=0
    for f in "$DIR"/*.log; do
        if [ -f "$f" ]; then
            local sz=$(wc -c < "$f")
            if [ "$sz" -gt 102400 ]; then
                tail -50 "$f" > "$f.tail" 2>/dev/null
                mv "$f.tail" "$f" 2>/dev/null
                local new_sz=$(wc -c < "$f")
                local saved=$((sz - new_sz))
                total_freed=$((total_freed + saved))
                log_count=$((log_count + 1))
                echo "  trim $(basename "$f") (saved $saved bytes)"
            fi
        fi
    done
    echo "  裁剪 $log_count 个日志"
    echo ""

    # 4. 空间统计
    echo "[4/4] 空间统计..."
    if [ -d "$DIR" ]; then
        echo "  目录大小: $(du -sh "$DIR" 2>/dev/null | cut -f1)"
        echo "  文件数量: $(ls "$DIR" 2>/dev/null | wc -l)"
    fi
    echo ""
    local freed_kb=$((total_freed / 1024))
    echo "╔══════════════════════════════════════╗"
    printf "║  释放空间: %-26s║\n" "$freed_kb KB"
    echo "╚══════════════════════════════════════╝"
}

# ── 设置沙盒地址 ──
do_seturl() {
    if [ -z "$1" ]; then
        echo "用法: xm seturl https://xxx.lhr.life"
        echo ""
        if [ -f "$CACHE_FILE" ]; then
            echo "当前地址: $(cat "$CACHE_FILE")"
        else
            echo "当前地址: (未设置)"
        fi
        return
    fi
    echo "$1" > "$CACHE_FILE"
    echo "✓ 沙盒地址已设置: $1"
}

# ── 主逻辑 ──
# 自动更新自身（除 seturl 命令外）
if [ "${1}" != "seturl" ] && [ "${1}" != "status" ]; then
    self_update "$@"
fi

case "${1:-run}" in
    pull)   do_pull ;;
    start)  do_start ;;
    stop)   do_stop ;;
    status) do_status ;;
    log)    do_log ;;
    clean)  do_clean ;;
    fw)     do_fw ;;
    flash)  do_flash ;;
    ports)  do_ports ;;
    seturl) do_seturl "$2" ;;
    update) do_pull && do_stop && do_start ;;
    run|"") do_pull && do_start ;;
    *) echo "XiaoMiaoOS 快捷命令 v3.0"
       echo ""
       echo "用法: xm [命令]"
       echo ""
       echo "命令:"
       echo "  xm          拉取+启动"
       echo "  xm pull     只拉取脚本文件"
       echo "  xm start    只启动"
       echo "  xm stop     停止所有服务"
       echo "  xm status   查看状态"
       echo "  xm log      查看日志"
       echo "  xm update   强制拉取+重启"
       echo "  xm fw       从沙盒拉取最新固件"
       echo "  xm flash    拉取固件+USB刷入设备"
       echo "  xm ports    列出可用串口"
       echo "  xm clean    清理旧文件释放空间"
       echo "  xm seturl   设置沙盒地址" ;;
esac
